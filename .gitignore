# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Kit d'agents Claude ---

# Mémoire locale Claude non partagée
.claude/agent-memory-local/
CLAUDE.local.md

# Réglages Claude locaux à la machine (hooks de l'atelier, permissions locales)
.claude/settings.local.json

# Exemple d'environnement volontairement versionné (exception à `.env*` ci-dessus)
!.env.example

# Artefacts locaux d'audit susceptibles de contenir des informations sensibles
artifacts/private/
reports/private/

# Documents de travail : un compte rendu, même fictif, n'a pas sa place dans Git.
*.pdf
!docs/**/*.pdf
